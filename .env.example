# Lokal: als .env.local anlegen (nur Secrets). URL und Shop-Schalter stehen in
# .env.development / .env.production, die übrigen Werte für Cloudflare in wrangler.jsonc.

# Stripe; STRIPE_WEBHOOK_SECRET stammt lokal aus `stripe listen`.
STRIPE_SECRET_KEY=sk_test_...

STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BODY=price_...
STRIPE_PRICE_MIND=price_...
STRIPE_PRICE_SET=price_...
# Versandtarife (Stripe Shipping Rates), kommagetrennt: erster = Standard.
STRIPE_SHIPPING_RATES=shr_...

# Resend: API-Key mit vollem Zugriff (Kontakte), verifizierter Absender, Empfänger der Bestellmails.
RESEND_API_KEY=re_...
RESEND_FROM="pronoia <hello@deinedomain.de>"
ORDER_NOTIFY_EMAIL=

# Newsletter (Double-Opt-in): Resend-Segment und HMAC-Secret (min. 32 Zeichen).
RESEND_SEGMENT_ID=
NEWSLETTER_SECRET=
